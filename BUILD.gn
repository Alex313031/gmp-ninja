  if (is_win) {
    configs -= [
      "//build/config/win:windowed_subsystem",
      "//build/config/win:unicode",
    ]
    configs += [
      "//build/config/win:console_subsystem",
      "//build/config/win:console_unicode",
    ]
  }
  configs += [ ":gmp_test_config" ]
  defines = [ "__GMP_WITHIN_GMPXX" ]
  sources = [
  ]
  deps = [
    ":gmp_tests_sources_shared",
  ]
}

static_library("gmp_tests_sources_static") {
  configs += [ ":gmp_test_config" ]
  defines = [ "_LIB" ]
  sources = [
  ]
  deps = [
    ":add_ssaaaa",
    ":sub_ddmmss",
  ]
}

shared_library("gmp_tests_sources_shared") {
  configs += [ ":gmp_test_config" ]
  defines = [ "__GMP_LIBGMP_DLL" ]
  sources = [
  ]
  deps = [
    ":add_ssaaaa",
    ":sub_ddmmss",
  ]
}

source_set("add_ssaaaa") {
  configs += [ ":gmp_test_config" ]
  defines = [ "main=devel_test_add_ssaaaa_main", ]
  sources = [
  ]
}

source_set("sub_ddmmss") {
  configs += [ ":gmp_test_config" ]
  defines = [ "main=devel_test_sub_ddmmss_main", ]
  sources = [
  ]
}

config("gmp_test_config") {
  defines = [
    "_CRT_NONSTDC_NO_DEPRECATE",
    "_CRT_SECURE_NO_WARNINGS",
    "__GMP_WITHIN_GMP",
  ]
  if (target_os == "win") {
    defines += [
      "WANT_WINSOCK2",
    ]
  }
  include_dirs = [
    "gmp",
    "gmp/tests",
    "missing",
  ]
  cflags_c = [ "-Wno-implicit-function-declaration" ]
  cflags = [
    "-Wno-constant-conversion",
    "-Wno-tautological-constant-out-of-range-compare",
    "-Wno-return-type",
    "-Wno-visibility",
    "-Wno-format",
  ]
  ldflags = [
  ]
}

assert(current_cpu != "arm64", "GMP GN/Ninja only supported on x86 and x64!")
