# Pi benchmark on Linux: one executable per (static, shared) link variant.
# Both compute pi to 1000 digits via Chudnovsky and report elapsed time
# in microseconds.  Build under different SIMD args (use_sse2 only vs.
# use_avx2=true) to see the asm-tune dispatch in action.

import("//src/gmp-ninja/asm.gni")

executable("test_gmp_linux_static") {
  configs += [ ":gmp_linux_static_config" ]
  sources = [ "gmp_linux_static.cc" ]
  deps = [ "//src/gmp-ninja/testapp/pi:pi_chudnovsky" ]
  if (gmp_asm_enabled) {
    # _with_asm variants drop the generic-C versions of the asm-provided
    # functions, leaving the asm impls (pulled in via the ldflags below)
    # to satisfy those references without colliding.
    deps += [
      "//src/gmp-ninja:libgmpxx_static_with_asm",
      "//src/gmp-ninja:gmp_asm",
    ]
  } else {
    deps += [
      "//src/gmp-ninja:libgmp_static",
      "//src/gmp-ninja:libgmpxx_static",
    ]
  }
}

executable("test_gmp_linux_shared") {
  configs += [ ":gmp_linux_shared_config" ]
  sources = [ "gmp_linux_shared.cc" ]
  deps = [
    "//src/gmp-ninja:libgmp",
    "//src/gmp-ninja:libgmpxx",
    "//src/gmp-ninja/testapp/pi:pi_chudnovsky",
  ]
}

config("gmp_linux_static_config") {
  ldflags = []
  if (gmp_asm_enabled) {
    # libgmp_static.a is pure-C; pull in libgmp_asm.a separately so the
    # static benchmark exercises the same asm impls as the shared one.
    # --whole-archive forces inclusion regardless of link order (ar
    # archives use lazy resolution; without --whole-archive the .a would
    # be discarded before its symbols are demanded by the source_set
    # objects coming after it on the link line).
    ldflags += [
      "-Wl,--whole-archive",
      rebase_path(gmp_asm_archive, root_build_dir),
      "-Wl,--no-whole-archive",
    ]
  }
}

config("gmp_linux_shared_config") {
  # RPATH=$ORIGIN so libgmp.so / libgmpxx.so are searched for in the
  # same directory as the executable.  This lets the user drop in
  # different builds of the .so (different SIMD tunes, asm on/off,
  # etc.) without rebuilding the test program.  $ is escaped with \$
  # because GN uses $ for variable expansion in strings.
  ldflags = [ "-Wl,-rpath=\$ORIGIN/" ]
}
